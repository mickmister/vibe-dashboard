{
  "plugins": [
    {
      "id": "vd.beads-web",
      "name": "Beads Web",
      "version": "0.1.0",
      "artifact": {
        "kind": "github-release-asset",
        "repository": "mickmister/beads-web",
        "tag": "v0.1.0",
        "asset": "beads-web-linux-x64.tar.gz",
        "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "signature": "TODO"
      },
      "services": [
        {
          "id": "web",
          "command": "${PLUGIN_DIR}/bin/beads-web",
          "args": ["--host", "127.0.0.1", "--port", "${BEADS_WEB_PORT}"],
          "directory": "${PLUGIN_DIR}",
          "user": "vkuser",
          "autostart": true,
          "autorestart": true,
          "singleton": true,
          "ports": [{ "name": "http", "env": "BEADS_WEB_PORT", "default": 3109, "bind": "127.0.0.1" }],
          "env": {
            "HOME": "/home/vkuser",
            "XDG_CONFIG_HOME": "/home/vkuser/.config"
          }
        }
      ]
    }
  ]
}
