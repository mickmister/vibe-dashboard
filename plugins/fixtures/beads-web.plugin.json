{
  "id": "vd.beads-web",
  "name": "Beads Web",
  "version": "v0.11.5",
  "services": [
    {
      "id": "web",
      "command": "${PLUGIN_DIR}/bin/beads-web",
      "args": [],
      "directory": "${PLUGIN_DIR}",
      "user": "vkuser",
      "autostart": true,
      "autorestart": true,
      "singleton": true,
      "ports": [
        {
          "name": "http",
          "env": "BEADS_WEB_PORT",
          "default": 3109,
          "bind": "0.0.0.0"
        }
      ],
      "env": {
        "HOST": "${BEADS_WEB_PORT_BIND}",
        "PORT": "${BEADS_WEB_PORT}",
        "HOME": "/home/vkuser",
        "XDG_CONFIG_HOME": "/home/vkuser/.config"
      },
      "httpExposure": {
        "kind": "caddy-subdomain",
        "subdomain": "beads-web",
        "port": "http"
      }
    }
  ],
  "installers": [
    {
      "kind": "github-release-asset",
      "repository": "mickmister/beads-web",
      "tag": "v0.11.5",
      "variants": {
        "linux-amd64": {
          "asset": "beads-web-linux-x64",
          "sha256": "8e06d418aee1f9f646750689befd53b2a63a331ab0d2c286ef097d2c046f3946"
        },
        "linux-arm64": {
          "asset": "beads-web-linux-arm64",
          "sha256": "95365fa46d65692580b5c25375ca5a96302d25be7848deb5c6a8e656b9eb55c1"
        }
      },
      "materialize": {
        "kind": "file",
        "installAs": "bin/beads-web",
        "mode": "0755",
        "outputs": [
          {
            "kind": "file",
            "path": "bin/beads-web",
            "mode": "0755"
          }
        ]
      },
      "bin": {
        "beads-web": "bin/beads-web"
      }
    }
  ]
}
