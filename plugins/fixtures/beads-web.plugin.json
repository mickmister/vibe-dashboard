{
  "id": "vd.beads-web",
  "name": "Beads Web",
  "version": "v0.11.4",
  "services": [
    {
      "id": "web",
      "command": "${PLUGIN_DIR}/bin/beads-web",
      "args": [],
      "directory": "${PLUGIN_DIR}",
      "user": "vkuser",
      "autostart": true,
      "autorestart": true,
      "singleton": true,
      "ports": [
        {
          "name": "http",
          "env": "BEADS_WEB_PORT",
          "default": 3109,
          "bind": "0.0.0.0"
        }
      ],
      "env": {
        "HOST": "${BEADS_WEB_PORT_BIND}",
        "PORT": "${BEADS_WEB_PORT}",
        "HOME": "/home/vkuser",
        "XDG_CONFIG_HOME": "/home/vkuser/.config"
      },
      "httpExposure": {
        "kind": "caddy-subdomain",
        "subdomain": "beads-web",
        "port": "http"
      }
    }
  ],
  "installers": [
    {
      "kind": "github-release-asset",
      "repository": "mickmister/beads-web",
      "tag": "v0.11.4",
      "variants": {
        "linux-amd64": {
          "asset": "beads-web-linux-x64",
          "sha256": "7e3880a399214b49a9c4a6ea2b2585f3b3fdbc69de093e464990395520791620"
        },
        "linux-arm64": {
          "asset": "beads-web-linux-arm64",
          "sha256": "4bf6c69625ae88bbd3438168f6d97267914b6edabe7da14fa2dc9c246fc47a1e"
        }
      },
      "materialize": {
        "kind": "file",
        "installAs": "bin/beads-web",
        "mode": "0755",
        "outputs": [
          {
            "kind": "file",
            "path": "bin/beads-web",
            "mode": "0755"
          }
        ]
      },
      "bin": {
        "beads-web": "bin/beads-web"
      }
    }
  ]
}
