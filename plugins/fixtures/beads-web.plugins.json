{
  "plugins": [
    {
      "id": "vd.beads-web",
      "name": "Beads Web",
      "version": "v0.11.6",
      "services": [
        {
          "id": "web",
          "command": "${PLUGIN_DIR}/bin/beads-web",
          "args": [],
          "directory": "${PLUGIN_DIR}",
          "user": "vkuser",
          "autostart": true,
          "autorestart": true,
          "singleton": true,
          "ports": [
            {
              "name": "http",
              "env": "BEADS_WEB_PORT",
              "default": 3109,
              "bind": "0.0.0.0"
            }
          ],
          "env": {
            "HOST": "${BEADS_WEB_PORT_BIND}",
            "PORT": "${BEADS_WEB_PORT}",
            "HOME": "/home/vkuser",
            "XDG_CONFIG_HOME": "/home/vkuser/.config"
          },
          "httpExposure": {
            "kind": "caddy-subdomain",
            "subdomain": "beads-web",
            "port": "http"
          }
        }
      ],
      "installers": [
        {
          "kind": "github-release-asset",
          "repository": "mickmister/beads-web",
          "tag": "v0.11.6",
          "variants": {
            "linux-amd64": {
              "asset": "beads-web-linux-x64",
              "sha256": "d37eb1c979015e1ede0018f8bc049b72f2eb68a6033ff7bf4d63572183200371"
            },
            "linux-arm64": {
              "asset": "beads-web-linux-arm64",
              "sha256": "384bd5433ac6fc5dc9fa8f43d87b1d8effe5d5af164622881ae105bea61d504f"
            }
          },
          "materialize": {
            "kind": "file",
            "installAs": "bin/beads-web",
            "mode": "0755",
            "outputs": [
              {
                "kind": "file",
                "path": "bin/beads-web",
                "mode": "0755"
              }
            ]
          },
          "bin": {
            "beads-web": "bin/beads-web"
          }
        }
      ]
    }
  ]
}
