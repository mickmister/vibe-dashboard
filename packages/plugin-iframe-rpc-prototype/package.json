{
  "name": "@vibe-kanban/plugin-iframe-rpc-prototype",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:fixture:host": "vite build --config vite.host.config.ts",
    "build:fixture:plugin": "vite build --config vite.plugin.config.ts",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:sample-e2e": "pnpm build && pnpm build:fixture:host && pnpm build:fixture:plugin && node scripts/sample-e2e-smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "springboard": "0.0.1-dev-server-modules-1",
    "vite": "^7.3.1",
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
