# 1. Load the plugin
# @plugin(@varlock/doppler-plugin)
#
# 2. Initialize the plugin
# @initDoppler(
#   project=vibe-dashboard,
#   config=prd_integrations,
#   serviceToken=$DOPPLER_TOKEN
# )
# ---

# Secret-zero token used only by Varlock to fetch Doppler-backed integration secrets.
# Put this in a local, git-ignored .env.integrations file and encrypt it with Varlock.
# @type=dopplerServiceToken @sensitive @internal @required
DOPPLER_TOKEN=

# Jira Cloud site hostname used by server-side bot-token board loading.
# Example: jamtools.atlassian.net
# @required
JIRA_SITE_HOSTNAME=doppler()

# Atlassian account email paired with JIRA_API_TOKEN for Jira Cloud Basic auth.
# @required @sensitive
JIRA_EMAIL=doppler()

# Atlassian API token paired with JIRA_EMAIL for Jira Cloud Basic auth.
# @required @sensitive
JIRA_API_TOKEN=doppler()

# Linear personal API key for server-side read-only Kanban loading.
# @required @sensitive
LINEAR_KANBAN_API_KEY=doppler()
