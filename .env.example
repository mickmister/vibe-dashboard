# Code-Server Password (required)
CODE_PASSWORD=change-me

# Optional: Sudo password for vkuser
# SUDO_PASSWORD=

# VK Version (default: latest)
# VIBE_KANBAN_VERSION=latest

# Ports (defaults shown)
# CADDY_PORT=3001
# VIBE_KANBAN_PORT=3007
# VS_CODE_PORT=3008
# BEADS_WEB_PORT=3009

# Optional wildcard proxy domain. When pointed at this host, Caddy supports:
# - http://<port>.example.com -> localhost:<port>
# - http://port-<port>.example.com -> localhost:<port> (legacy)
# - http://beads-web.example.com -> beads-web
# PROXY_DOMAIN=example.com

# Bosun autonomous engineering (optional)
# ENABLE_BOSUN=true

# Tailscale (optional)
# TAILSCALE_AUTHKEY=
# TAILSCALE_HOSTNAME=vkdev

# Memory watchdog (optional)
# MEMORY_WATCHDOG_ENABLED=true
# MEMORY_WATCHDOG_MATTERMOST_WEBHOOK_URL=https://mattermost.example.com/hooks/xxx-generatedkey-xxx
# MEMORY_WATCHDOG_PROCESS_THRESHOLD_MB=4096
# MEMORY_WATCHDOG_TOTAL_THRESHOLD_PERCENT=60

# VK Cloud Connection (optional - connect this local VK to a self-hosted cloud instance)
# If set, both the local VK backend and frontend will connect to this cloud server
# Leave empty to run in pure local mode
# VK_CLOUD_URL=https://vk-cloud.example.com

# GitHub webhook secret for CI failure notifications
# Generate with: openssl rand -hex 32
# GITHUB_WEBHOOK_SECRET=
