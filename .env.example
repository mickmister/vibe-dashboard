# Code-Server Password (required)
CODE_PASSWORD=change-me

# Optional: Sudo password for vkuser
# SUDO_PASSWORD=

# VK Version (default: latest)
# VIBE_KANBAN_VERSION=latest

# Ports (defaults shown)
# CADDY_PORT=3001
# BACKEND_PORT=3007
# DASHBOARD_PORT=3005
# CODE_PORT=3008

# Bosun autonomous engineering (optional)
# ENABLE_BOSUN=true

# Tailscale (optional)
# TAILSCALE_AUTHKEY=
# TAILSCALE_HOSTNAME=vkdev

# Memory watchdog (optional)
# MEMORY_WATCHDOG_ENABLED=true
# MEMORY_WATCHDOG_MATTERMOST_WEBHOOK_URL=https://mattermost.example.com/hooks/xxx-generatedkey-xxx
# MEMORY_WATCHDOG_PROCESS_THRESHOLD_MB=4096
# MEMORY_WATCHDOG_TOTAL_THRESHOLD_PERCENT=60

# VK Cloud Connection (optional - connect this local VK to a self-hosted cloud instance)
# If set, both the local VK backend and frontend will connect to this cloud server
# Leave empty to run in pure local mode
# VK_CLOUD_URL=https://vk-cloud.example.com

# Optional override for workspace tab URLs. Leave empty to use relative URLs.
# Example: https://example.com
# VITE_VK_BASE_ORIGIN=

# Vibe Kanban performance tracing to SigNoz (optional)
# Tracing/export is disabled unless VK_PERF_TRACING=1 and an OTLP endpoint are set.
# VK_PERF_TRACING=1
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-ingestion-key>
# OTEL_SERVICE_NAME=vibe-kanban-backend
# OTEL_RESOURCE_ATTRIBUTES=service.version=local-compose
# Extra noisy websocket poll tracing; normally leave unset.
# VK_WS_POLL_TRACING=1

# GitHub webhook secret for CI failure notifications
# Generate with: openssl rand -hex 32
# GITHUB_WEBHOOK_SECRET=
