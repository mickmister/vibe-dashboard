{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./ui-customization-targets.schema.json",
  "title": "VD UI customization OpenLint targets",
  "type": "object",
  "additionalProperties": false,
  "required": ["presets", "migratedSurfaces"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "migratedSurfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "reviewOnlySurfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
