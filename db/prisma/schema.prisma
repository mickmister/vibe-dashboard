generator kysely {
  provider = "prisma-kysely"
  output   = "../../src/store"
  fileName = "kysely_types.ts"
}

// Migration registry maintained by the application's Kysely migration runner.
model Migration {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model BetterAuthUser {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions                    BetterAuthSession[]
  accounts                    BetterAuthAccount[]
  externalProviderConnections ExternalProviderConnection[]
}

model BetterAuthSession {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BetterAuthAccount {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  user                        BetterAuthUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalProviderConnections ExternalProviderConnection[]

  @@unique([providerId, accountId])
  @@index([userId])
  @@index([providerId])
}

model BetterAuthVerification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

enum ExternalProvider {
  jira
  github
  linear
}

model ExternalProviderConnection {
  id                   String           @id
  userId               String
  provider             ExternalProvider
  betterAuthAccountId  String
  providerAccountId    String
  displayName          String?
  resourceMetadataJson String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @default(now()) @updatedAt

  user              BetterAuthUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  betterAuthAccount BetterAuthAccount @relation(fields: [betterAuthAccountId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
  @@index([betterAuthAccountId])
}

model ExternalIssue {
  id           String           @id
  provider     ExternalProvider
  issueKey     String
  issueId      String?
  issueUrl     String
  site         String?
  metadataJson String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  workspaceLinks ExternalIssueWorkspaceLink[]

  @@unique([provider, site, issueKey])
  @@index([provider, issueKey])
  @@index([issueId])
}

model VKWorkspace {
  id           String   @id
  workspaceId  String   @unique
  workspaceDir String?
  displayName  String?
  metadataJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  externalIssueLinks ExternalIssueWorkspaceLink[]

  @@index([workspaceDir])
}

model ExternalIssueWorkspaceLink {
  id              String    @id
  externalIssueId String
  vkWorkspaceId   String
  isPrimary       Boolean   @default(false)
  lastOpenedAt    DateTime?
  metadataJson    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  externalIssue ExternalIssue @relation(fields: [externalIssueId], references: [id], onDelete: Cascade)
  vkWorkspace   VKWorkspace   @relation(fields: [vkWorkspaceId], references: [id], onDelete: Cascade)

  @@unique([externalIssueId, vkWorkspaceId])
  @@index([externalIssueId])
  @@index([vkWorkspaceId])
  @@index([isPrimary])
}

model ExternalRepoProjectMapping {
  id            String           @id
  repoId        String
  repoName      String?
  provider      ExternalProvider
  siteHostname  String
  projectKey    String
  issueTypeName String?
  metadataJson  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  @@unique([repoId, provider, siteHostname])
  @@index([provider, siteHostname, projectKey])
}

model Voyage {
  id                    String    @id
  schemaVersion         Int       @default(1)
  revision              Int       @default(0)
  activationSequence    Int       @default(0)
  historyCursorSequence Int?
  name                  String
  mission               String?
  lifecycleState        String    @default("active")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())
  lastOpenedAt          DateTime?

  crafts               VoyageCraft[]
  panels               VoyagePanel[]
  layout               VoyageLayout?
  history              VoyageHistory[]
  layoutQuarantines    VoyageLayoutQuarantine[]
  migrationDiagnostics VoyageMigrationDiagnostic[]
}

model VoyageCraft {
  voyageId         String
  /// External Vibe Kanban workspace logical ID. This intentionally has no
  /// database foreign key to VKWorkspace: VK workspaces may live outside this
  /// database and their lifecycle is independent from Voyage persistence.
  craftWorkspaceId String
  sortKey          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  voyage Voyage        @relation(fields: [voyageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  panels VoyagePanel[]

  @@id([voyageId, craftWorkspaceId])
}

model VoyagePanel {
  id                    String   @id
  voyageId              String
  craftWorkspaceId      String?
  targetKind            String
  targetVersion         Int
  targetPayloadJson     String
  titleMode             String
  customTitle           String?
  closePolicy           String
  lastActivatedSequence Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now())

  voyage Voyage       @relation(fields: [voyageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  craft  VoyageCraft? @relation(fields: [voyageId, craftWorkspaceId], references: [voyageId, craftWorkspaceId], onDelete: Cascade, onUpdate: Cascade)

  @@index([voyageId])
  @@index([voyageId, craftWorkspaceId])
}

model VoyageLayout {
  voyageId          String   @id
  formatVersion     Int
  dockviewVersion   String
  aggregateRevision Int
  snapshotJson      String
  snapshotHash      String
  updatedAt         DateTime @default(now())

  voyage Voyage @relation(fields: [voyageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model VoyageHistory {
  id                String   @id
  voyageId          String
  sequence          Int
  aggregateRevision Int
  panelsJson        String
  snapshotJson      String
  createdAt         DateTime @default(now())

  voyage Voyage @relation(fields: [voyageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([voyageId, sequence])
  @@index([voyageId])
}

model VoyageLayoutQuarantine {
  id                   String    @id
  voyageId             String
  sourceRevision       Int
  reasonCode           String
  rejectedSnapshotJson String
  createdAt            DateTime  @default(now())
  resolvedAt           DateTime?

  voyage Voyage @relation(fields: [voyageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([voyageId])
}

model VoyageSettings {
  singletonKey       String   @id @default("installation")
  warmVoyageLimit    Int      @default(2)
  iframeRuntimeLimit Int      @default(5)
  historyLimit       Int      @default(50)
  updatedAt          DateTime @default(now())
}

model VoyageMigrationDiagnostic {
  id            String   @id
  migrationName String
  voyageId      String?
  sourceKind    String
  sourceId      String?
  outcome       String
  reasonCode    String
  detailsJson   String?
  createdAt     DateTime @default(now())

  voyage Voyage? @relation(fields: [voyageId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([migrationName])
  @@index([voyageId])
}
