MM_ADMIN_TOKEN=

MM_APPS_AWS_ACCESS_KEY=
MM_APPS_AWS_SECRET_KEY=
MM_APPS_S3_BUCKET=
MM_APPS_AWS_REGION=

OPENFAAS_URL=

# Local bootstrap defaults used by bootstrap-local.mjs.
MATTERMOST_URL=http://localhost:8065
MATTERMOST_BOOTSTRAP_ADMIN_EMAIL=sysadmin@example.com
MATTERMOST_BOOTSTRAP_ADMIN_USERNAME=sysadmin
MATTERMOST_BOOTSTRAP_ADMIN_PASSWORD=Sysadmin123!
MATTERMOST_BOOTSTRAP_TEAM_NAME=vibe
MATTERMOST_BOOTSTRAP_TEAM_DISPLAY_NAME=Vibe Kanban
MATTERMOST_BOOTSTRAP_CHANNEL_NAME=vibe-testing
MATTERMOST_BOOTSTRAP_CHANNEL_DISPLAY_NAME=Vibe Testing
MATTERMOST_BOOTSTRAP_CHANNEL_PURPOSE=Local Vibe Kanban integration test traffic
MATTERMOST_BOOTSTRAP_BOT_USERNAME=vibe-bot
MATTERMOST_BOOTSTRAP_BOT_DISPLAY_NAME=Vibe Kanban Bot
MATTERMOST_BOOTSTRAP_BOT_DESCRIPTION=Local bridge bot for the Vibe Kanban Mattermost integration
MATTERMOST_BOOTSTRAP_COMMAND_TRIGGER=vibe

# This URL must be reachable from inside the Mattermost container.
# For a host-running bridge, host.docker.internal works on macOS, Windows, and
# recent Docker-on-Linux installs. Override it if your Docker runtime differs.
MATTERMOST_BOOTSTRAP_PUBLIC_BASE_URL=http://host.docker.internal:3000
MATTERMOST_BOOTSTRAP_SLASH_COMMAND_PATH=/api/mattermost/slash

# bootstrap-local.mjs writes these values back into .docker.env after the first
# successful run so the local bridge can reuse them.
MATTERMOST_BOOTSTRAP_TEAM_ID=
MATTERMOST_BOOTSTRAP_CHANNEL_ID=
MATTERMOST_BOOTSTRAP_BOT_USER_ID=
MATTERMOST_BOOTSTRAP_BOT_TOKEN=
MATTERMOST_BOOTSTRAP_SLASH_COMMAND_ID=
MATTERMOST_BOOTSTRAP_SLASH_COMMAND_TOKEN=

# VK -> Mattermost webhook endpoint. Configure VK Generic webhook URL to:
#   ${MATTERMOST_BOOTSTRAP_PUBLIC_BASE_URL}${MATTERMOST_BRIDGE_VK_WEBHOOK_PATH}
# and set the same shared secret in VK's webhook Signing Secret field.
MATTERMOST_BRIDGE_VK_WEBHOOK_PATH=/api/mattermost/vk-webhook
MATTERMOST_BRIDGE_VK_WEBHOOK_SECRET=change-me
