{
  "name": "vibe-kanban-vscode-web",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "vite",
    "start": "node dist/node/node-entry.mjs",
    "build": "npm run build:web && npm run build:node",
    "build:web": "SPRINGBOARD_PLATFORM=web vite build",
    "build:node": "SPRINGBOARD_PLATFORM=node vite build --outDir dist/node",
    "check-types": "tsc --noEmit",
    "test": "vitest run --config vitest.server.config.ts",
    "storybook": "npm run build-storybook && npm run serve-storybook",
    "storybook:dev": "storybook dev -p $PORT",
    "build-storybook": "storybook build",
    "serve-storybook": "serve storybook-static -l $PORT",
    "validate:caddy": "node --experimental-strip-types scripts/validate-plugin-caddy.ts",
    "test:container-runtime": "vitest run --config vitest.server.config.ts plugins/orchestrator/container-runtime.test.ts",
    "test:first-party-services": "vitest run --config vitest.server.config.ts plugins/orchestrator/first-party-services.test.ts",
    "test:staging-promotion": "vitest run --config vitest.server.config.ts plugins/orchestrator/staging-runtime.test.ts",
    "plugin-services:dry-run:beads-web": "node --experimental-strip-types plugins/orchestrator/plugin-service-orchestrator-cli.ts dry-run --catalog plugins/builtin.plugins.json --optional-catalog /var/lib/vd/instance-config/plugins.json --artifact-cache-root /var/lib/vd/plugin-cache --install-root /var/lib/vd/plugins --plugin-bin-dir /var/lib/vd/plugin-bin --toolchain-root /var/lib/vd/toolchains --supervisor-config-dir /etc/supervisor/conf.d/vd-generated --caddy-plugin-config-path /etc/caddy/plugins.caddy",
    "plugin-services:apply:beads-web": "VD_PLUGIN_ORCHESTRATOR_INSTALL_ARTIFACTS=true node --experimental-strip-types plugins/orchestrator/plugin-service-orchestrator-cli.ts apply --catalog plugins/builtin.plugins.json --optional-catalog /var/lib/vd/instance-config/plugins.json --artifact-cache-root /var/lib/vd/plugin-cache --install-root /var/lib/vd/plugins --plugin-bin-dir /var/lib/vd/plugin-bin --toolchain-root /var/lib/vd/toolchains --supervisor-config-dir /etc/supervisor/conf.d/vd-generated --caddy-plugin-config-path /etc/caddy/plugins.caddy",
    "plugin-instance:dry-run-add:beads-web": "node --experimental-strip-types plugins/orchestrator/plugin-instance-config-cli.ts dry-run-add --config-repo-dir /var/lib/vd/instance-config --plugin plugins/fixtures/beads-web.plugin.json",
    "plugin-instance:apply-add:beads-web": "node --experimental-strip-types plugins/orchestrator/plugin-instance-config-cli.ts apply-add --approved true --config-repo-dir /var/lib/vd/instance-config --plugin plugins/fixtures/beads-web.plugin.json",
    "test:server": "vitest run --config vitest.server.config.ts"
  },
  "dependencies": {
    "@heroui/react": "^2.8.9",
    "@hono/node-server": "^1.19.9",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.1.18",
    "@vibe-dashboard/workflow-core": "workspace:*",
    "@vitejs/plugin-react": "^5.1.4",
    "better-sqlite3": "^12.6.2",
    "crossws": "^0.4.4",
    "framer-motion": "^12.34.0",
    "hono": "^4.11.9",
    "immer": "^11.1.4",
    "kysely": "^0.28.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.6.5",
    "react-router": "^7.13.0",
    "rxjs": "^7.8.2",
    "springboard": "0.0.1-dev-server-modules-1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-onboarding": "^10.2.10",
    "@storybook/addon-vitest": "^10.2.10",
    "@storybook/blocks": "^8.6.14",
    "@storybook/builder-vite": "^10.2.10",
    "@storybook/react-vite": "^10.2.10",
    "@storybook/test": "^8.6.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "playwright": "^1.58.2",
    "serve": "^14.2.5",
    "storybook": "^10.2.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "bin": {
    "vibe-agent": "./bin/vibe-agent",
    "vk": "./bin/vk"
  }
}
