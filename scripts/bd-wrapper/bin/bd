#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import tempfile

REAL_BD = os.environ.get('REAL_BD', '/usr/local/bin/bd')


def current_branch() -> str:
    override = os.environ.get('VK_BD_WRAPPER_BRANCH')
    if override is not None:
        return override
    try:
        return subprocess.run(
            ['git', 'branch', '--show-current'],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        ).stdout.strip()
    except Exception:
        return ''


def stamp_metadata(metadata: dict, *, include_empty: bool) -> dict:
    stamped = {}
    branch = current_branch()
    if include_empty or branch:
        stamped['branch'] = branch
    for key in ['VK_WORKSPACE_ID', 'VK_SESSION_ID']:
        value = os.environ.get(key, '')
        if include_empty or value:
            stamped[key] = value
    metadata.update(stamped)
    return metadata


def read_metadata(raw_metadata: str) -> dict:
    if raw_metadata.startswith('@'):
        with open(raw_metadata[1:], 'r', encoding='utf-8') as metadata_file:
            parsed = json.load(metadata_file)
    else:
        parsed = json.loads(raw_metadata)
    if not isinstance(parsed, dict):
        raise SystemExit('--metadata must be a JSON object')
    return parsed


def write_metadata_arg(metadata: dict) -> str:
    tmp = tempfile.NamedTemporaryFile('w', encoding='utf-8', prefix='vk-bd-metadata-', suffix='.json', delete=False)
    with tmp:
        json.dump(metadata, tmp, separators=(',', ':'))
    return '@' + tmp.name


def split_metadata_args(args: list[str]) -> tuple[list[str], dict]:
    remaining: list[str] = []
    metadata: dict = {}
    skip_next = False
    for index, arg in enumerate(args):
        if skip_next:
            skip_next = False
            continue
        raw_metadata = None
        if arg == '--metadata':
            if index + 1 >= len(args):
                remaining.append(arg)
                continue
            raw_metadata = args[index + 1]
            skip_next = True
        elif arg.startswith('--metadata='):
            raw_metadata = arg.split('=', 1)[1]
        else:
            remaining.append(arg)
            continue

        if raw_metadata:
            metadata.update(read_metadata(raw_metadata))
    return remaining, metadata


def command_with_stamped_metadata(command: str, args: list[str], *, include_empty: bool) -> list[str] | None:
    command_args, metadata = split_metadata_args(args)
    if not metadata:
        return None
    stamped = stamp_metadata(metadata, include_empty=include_empty)
    return [REAL_BD, command, *command_args, '--metadata', write_metadata_arg(stamped)]


def main() -> None:
    argv = sys.argv[1:]
    if not argv:
        os.execv(REAL_BD, [REAL_BD])

    if argv[0] == 'create':
        command = command_with_stamped_metadata('create', argv[1:], include_empty=True)
        if command is None:
            command = [REAL_BD, 'create', *argv[1:], '--metadata', write_metadata_arg(stamp_metadata({}, include_empty=True))]
        os.execv(REAL_BD, command)

    if argv[0] == 'update':
        command = command_with_stamped_metadata('update', argv[1:], include_empty=False)
        if command is not None:
            os.execv(REAL_BD, command)

    os.execv(REAL_BD, [REAL_BD, *argv])


if __name__ == '__main__':
    main()
