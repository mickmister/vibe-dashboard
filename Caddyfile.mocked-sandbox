{
	admin off
	auto_https off
}

:{$VK_MOCKED_CADDY_PORT} {
	# VD browser code calls /vk-api/*; strip that prefix to reach VK /api/*.
	handle_path /vk-api/* {
		rewrite * /api{uri}
		reverse_proxy 127.0.0.1:{$VK_MOCKED_BACKEND_PORT}
	}

	# VD app and Springboard dev assets.
	@vd {
		path /
		path /dashboard /dashboard/*
		path /.springboard/*
		path /node_modules/*
		path /packages/*
		path /src/*
		path /@vite/*
		path /@id/*
		path /@react-refresh
		path /@fs/*
		path /kv/*
		path /rpc/*
		path /assets/*
		path /ws
		path /manifest.json
	}
	handle @vd {
		reverse_proxy 127.0.0.1:{$VK_MOCKED_VD_DASHBOARD_PORT}
	}

	# VK workspace-create and agent routes fall through to VK local-web dev.
	handle {
		reverse_proxy 127.0.0.1:{$VK_MOCKED_FRONTEND_PORT}
	}
}
