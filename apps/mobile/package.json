{
  "private": true,
  "name": "vibe-dashboard-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "expo start",
    "start": "EXPO_APP_PROFILE=local expo start --clear",
    "android": "[ ! -d android ] && (expo prebuild || exit 1); pnpm run eas-build-post-install && EXPO_APP_PROFILE=local expo run:android",
    "ios": "pnpm run eas-build-post-install && EXPO_APP_PROFILE=local expo run:ios",
    "prepare:web": "cd ../.. && pnpm run mobile:prepare",
    "eas-build-post-install": "cd ../.. && pnpm run mobile:prepare"
  },
  "dependencies": {
    "@assistant-ui/react-native": "0.1.38",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "assistant-cloud": "0.1.31",
    "expo": "~53.0.25",
    "expo-asset": "~11.1.7",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-file-system": "~18.1.11",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-image-picker": "~16.1.4",
    "expo-splash-screen": "^31.0.13",
    "expo-symbols": "~0.4.5",
    "expo-updates": "~0.28.18",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-webview": "^13.16.0",
    "springboard": "git+https://github.com/jamtools/springboard.git#78f4025b29a7e416edfefd2ada6f3d4c1165e2a8&path:/packages/springboard"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "babel-preset-expo": "~13.0.0"
  }
}
