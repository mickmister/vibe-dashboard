{
  "cli": {
    "promptToConfigurePushNotifications": false,
    "appVersionSource": "remote"
  },
  "build": {
    "monorepo": {
      "pnpm": "10.15.0",
      "node": "20.17.0",
      "env": {
        "EXPO_USE_FAST_RESOLVER": "true"
      },
      "channel": "monorepo",
      "autoIncrement": true
    },
    "local": {
      "channel": "local",
      "distribution": "internal",
      "extends": "monorepo",
      "developmentClient": true,
      "env": {
        "EXPO_APP_PROFILE": "local",
        "EXPO_PUBLIC_SITE_URL": "http://127.0.0.1:1337",
        "PUBLIC_SITE_URL": "http://127.0.0.1:1337"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m1-medium"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "extends": "monorepo",
      "developmentClient": false,
      "env": {
        "EXPO_APP_PROFILE": "preview"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m1-medium"
      },
      "environment": "preview"
    },
    "mobile-e2e": {
      "channel": "mobile-e2e",
      "distribution": "internal",
      "extends": "preview",
      "developmentClient": false,
      "env": {
        "EXPO_APP_PROFILE": "mobile-e2e",
        "EXPO_PUBLIC_SITE_URL": "http://10.0.2.2:1337",
        "PUBLIC_SITE_URL": "http://10.0.2.2:1337",
        "EXPO_LOAD_WEBVIEW_FROM_SITE_URL": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "extends": "monorepo",
      "developmentClient": false,
      "env": {
        "EXPO_APP_PROFILE": "production"
      },
      "environment": "production"
    }
  }
}
