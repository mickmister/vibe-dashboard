{
	admin off
	auto_https off
}

:{$CADDY_PORT:3001} {
	# Dynamic port forwarding via subdomain: port-<port_num>.* -> localhost:<port_num>
	# This must be checked FIRST before other handlers
	@port_forward header_regexp port Host ^port-([0-9]+)\.

	handle @port_forward {
		# VK API routes should be proxied to main vibe-kanban instance (localhost:{$BACKEND_PORT:3007})
		# instead of the dynamic port, so the wrapper can access task attempts
		@vk_api_routes {
			path /api/task-attempts
			path /api/task-attempts/*
		}

		handle @vk_api_routes {
			reverse_proxy localhost:{$BACKEND_PORT:3007} {
				header_up Host {upstream_hostport}
			}
		}

		# Default port forwarding for everything else
		handle {
			reverse_proxy 127.0.0.1:{re.port.1} {
				header_up Host {upstream_hostport}
				header_up Upgrade {http.request.header.Upgrade}
				header_up Connection {http.request.header.Connection}
			}
		}
	}

	# Handle errors (502/503/504) for port forwarding - show startup page
	handle_errors {
		@port_forward_error {
			expression {http.request.host}.startsWith("port-")
		}
		handle @port_forward_error {
			root * /etc/caddy
			rewrite * /startup.html
			file_server
		}
		# Default error response for other errors
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}

	# Vibe Dashboard app
	@vibe_dashboard_root {
		path /dashboard
	}

	@vibe_dashboard_assets {
		path /.springboard/*
		path /node_modules/*
		path /src/*
		path /@vite/*
		path /@id/*
		path /@react-refresh
		path /react-chrome-tabs/*
		path /@fs/*
		path /kv/*
		path /rpc/*
		path /assets/*
	}

	# Hashed assets (e.g. /assets/index-B1rC7_Az.js) are content-addressed and safe to cache indefinitely
	@hashed_assets {
		path_regexp /assets/.+-[A-Za-z0-9_-]+\.(js|css|woff2?|png|jpg|svg|webp)$
	}
	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

	@vibe_dashboard_ws {
		path /ws
	}

	@vibe_dashboard_manifest {
		path /manifest.json
	}

	# Wrapper app — root page (no folder= query)
	handle @vibe_dashboard_root {
		reverse_proxy localhost:{$DASHBOARD_PORT:3005} {
			header_up Host {upstream_hostport}
			header_up Upgrade {http.request.header.Upgrade}
			header_up Connection {http.request.header.Connection}
		}
	}

	# Wrapper app — static assets and API routes
	handle @vibe_dashboard_assets {
		# Proxy /assets to wrapper first; if missing there, fall back to vibe-kanban.
		@asset_path path /assets/*
		handle @asset_path {
			reverse_proxy localhost:{$DASHBOARD_PORT:3005} {
				header_up Host {upstream_hostport}
				header_up Upgrade {http.request.header.Upgrade}
				header_up Connection {http.request.header.Connection}

				@wrapper_asset_error status 404 502
				handle_response @wrapper_asset_error {
					reverse_proxy localhost:{$BACKEND_PORT:3007} {
						header_up Host {upstream_hostport}
						header_up Upgrade {http.request.header.Upgrade}
						header_up Connection {http.request.header.Connection}
					}
				}
			}
		}

		handle {
			reverse_proxy localhost:{$DASHBOARD_PORT:3005} {
				header_up Host {upstream_hostport}
				header_up Upgrade {http.request.header.Upgrade}
				header_up Connection {http.request.header.Connection}
			}
		}
	}

	# Wrapper app — WebSocket
	handle @vibe_dashboard_ws {
		reverse_proxy localhost:{$DASHBOARD_PORT:3005} {
			header_up Host {upstream_hostport}
			header_up Upgrade {http.request.header.Upgrade}
			header_up Connection {http.request.header.Connection}
		}
	}

	# Wrapper app — PWA manifest
	handle @vibe_dashboard_manifest {
		reverse_proxy localhost:{$DASHBOARD_PORT:3005} {
			header_up Host {upstream_hostport}
		}
	}

	# Route to VSCode Server if URL has "folder" query parameter
	@vscode_query {
		query folder=*
	}

	# Route to VSCode Server for stable-* paths (VSCode assets)
	@vscode_stable {
		path /stable-*
	}

	# Route to VSCode Server for vscode-remote-resource paths
	@vscode_remote {
		path /vscode-remote-resource*
	}

	# VSCode Server - proxy to code-server on localhost:{$PORT:3008} (query param routing)
	handle @vscode_query {
		reverse_proxy localhost:{$PORT:3008} {
			header_up Host {upstream_hostport}
			# Handle WebSocket connections
			header_up Upgrade {http.request.header.Upgrade}
			header_up Connection {http.request.header.Connection}
		}
	}

	# VSCode Server - proxy to code-server on localhost:{$PORT:3008} (stable-* asset routing)
	handle @vscode_stable {
		reverse_proxy localhost:{$PORT:3008} {
			header_up Host {upstream_hostport}
		}
	}

	# VSCode Server - proxy to code-server on localhost:{$PORT:3008} (vscode-remote-resource routing)
	handle @vscode_remote {
		reverse_proxy localhost:{$PORT:3008} {
			header_up Host {upstream_hostport}
		}
	}

	# Main application - proxy to vibe-kanban on localhost:{$BACKEND_PORT:3007} (fallback)
	handle /* {
		# VK_SHARED_API_BASE now configured at runtime (PR #2769)
		# No custom Caddy module needed

		reverse_proxy localhost:{$BACKEND_PORT:3007} {
			# Handle WebSocket connections for hot reload, etc.
			header_up Upgrade {http.request.header.Upgrade}
			header_up Connection {http.request.header.Connection}
		}
	}

	# Enable logging for debugging
	log {
		output stdout
		format console
		level INFO
	}
}
