# @plugin(@varlock/doppler-plugin@1.1.0)
# @initDoppler(project=vibe-dashboard, config=$DOCS_DEPLOY_TARGET, serviceToken=$DOPPLER_TOKEN, cacheTtl=false)
# @currentEnv=$DOCS_DEPLOY_TARGET
# @defaultSensitive=false @defaultRequired=false
# ---

# Varlock/Doppler deployment target selector.
# This is not a GitHub Environment. It selects the Doppler config used by @initDoppler above.
# Keep Doppler config names aligned with these values, or update @initDoppler(config=...).
# @type=enum(development, preview, production)
# @required
DOCS_DEPLOY_TARGET=development

# Doppler service token injected by GitHub Actions from the repository secret DOPPLER_TOKEN.
# Varlock uses it to resolve the deploy-only secrets below; it is not passed to Wrangler.
# @type=dopplerServiceToken @sensitive
DOPPLER_TOKEN=

# Public canonical URL used in generated docs metadata and social previews.
# @type=url
# @required
DOCS_SITE_URL=https://vibedashboard.dev

# GitHub repository slug used by the docs UI for source links.
# @type=string
# @required
DOCS_GITHUB_REPO=mickmister/vibe-dashboard

# Cloudflare account ID used by GitHub Actions deploy jobs.
# Resolved from a Doppler secret with the same name in the selected Doppler config.
# @type=string
# @sensitive
CLOUDFLARE_ACCOUNT_ID=doppler()

# Cloudflare API token scoped to deploy this Worker.
# Resolved from a Doppler secret with the same name in the selected Doppler config.
# @type=string
# @sensitive
CLOUDFLARE_API_TOKEN=doppler()
