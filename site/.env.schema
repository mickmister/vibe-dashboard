# @plugin(@varlock/doppler-plugin@1.1.0)
# @initDoppler(project=vibe-dashboard, config=prd_docs_deploy, serviceToken=$DOCS_DEPLOY_DOPPLER_TOKEN, cacheTtl=false)
# @defaultSensitive=false @defaultRequired=false
# ---

# Doppler service token injected by GitHub Actions from the repository secret DOCS_DEPLOY_DOPPLER_TOKEN.
# Varlock uses it to resolve the deploy-only secrets below; it is not passed to Wrangler.
# @type=dopplerServiceToken @sensitive
DOCS_DEPLOY_DOPPLER_TOKEN=

# Public canonical URL used in generated docs metadata and social previews.
# @type=url
# @required
DOCS_SITE_URL=https://vibedashboard.dev

# GitHub repository slug used by the docs UI for source links.
# @type=string
# @required
DOCS_GITHUB_REPO=mickmister/vibe-dashboard

# Cloudflare account ID used by GitHub Actions deploy jobs.
# Resolved from Doppler project vibe-dashboard, config prd_docs_deploy.
# @type=string
# @sensitive
CLOUDFLARE_ACCOUNT_ID=doppler()

# Cloudflare API token scoped to deploy this Worker.
# Resolved from Doppler project vibe-dashboard, config prd_docs_deploy.
# @type=string
# @sensitive
CLOUDFLARE_API_TOKEN=doppler()
