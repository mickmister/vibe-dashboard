# syntax=docker/dockerfile:1.6

ARG VK_REPO_URL=https://github.com/mickmister/vibe-kanban.git
ARG VK_BRANCH=main
ARG VK_COMMIT=
ARG VK_RUNTIME_SOURCE=github
ARG CODEX_RELEASE_REPO=mickmister/codex
ARG CODEX_RELEASE_TAG=codex-cli-assets-dc198b6aa9597a0b82a7488d2d2777933ad01329
ARG CODEX_RELEASE_ASSET=
ARG BEADS_VERSION=v1.2.2

FROM alpine:3.19 AS vk-runtime-downloader

ARG VK_BRANCH
ARG VK_COMMIT
ARG VK_RUNTIME_SOURCE
ARG TARGETARCH

RUN apk add --no-cache curl jq tar

WORKDIR /vk-release
RUN set -eux; \
    test -n "${VK_COMMIT}"; \
    if [ "${VK_RUNTIME_SOURCE}" = "stub" ]; then \
      mkdir -p /vk-runtime; \
      printf '#!/bin/sh\nprintf "vibe-kanban CI runtime stub %s\\n" "$*"\n' "${VK_COMMIT}" > /vk-runtime/vibe-kanban; \
      chmod +x /vk-runtime/vibe-kanban; \
      printf '%s@%s\n' "${VK_BRANCH}" "$(printf '%s' "${VK_COMMIT}" | cut -c1-12)" > /vk-build-version; \
      exit 0; \
    fi; \
    test "${VK_RUNTIME_SOURCE}" = "github"; \
    case "${TARGETARCH}" in \
      amd64) vk_platform="linux-x64" ;; \
      arm64) vk_platform="linux-arm64" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    release_tag="vk-assets-${VK_COMMIT}"; \
    release_base_url="https://github.com/mickmister/vibe-kanban/releases/download/${release_tag}"; \
    manifest_url="${release_base_url}/manifest.json"; \
    curl -fsSL "${manifest_url}" -o manifest.json; \
    test "$(jq -r '.schema_version' manifest.json)" = "1"; \
    manifest_mode="$(jq -r '.mode' manifest.json)"; \
    case "${manifest_mode}" in \
      linux-container-runtime|standalone-runtime-assets) ;; \
      *) echo "unsupported VK release asset mode: ${manifest_mode}" >&2; exit 1 ;; \
    esac; \
    test "$(jq -r '.release_tag' manifest.json)" = "${release_tag}"; \
    test "$(jq -r '.commit' manifest.json)" = "${VK_COMMIT}"; \
    asset_file="$(jq -r --arg platform "${vk_platform}" '.platforms[$platform].assets["vibe-kanban"].file' manifest.json)"; \
    asset_sha="$(jq -r --arg platform "${vk_platform}" '.platforms[$platform].assets["vibe-kanban"].sha256' manifest.json)"; \
    test -n "${asset_file}" && test "${asset_file}" != "null"; \
    test -n "${asset_sha}" && test "${asset_sha}" != "null"; \
    curl -fsSL "${release_base_url}/${asset_file}" -o "${asset_file}"; \
    curl -fsSL "${release_base_url}/${asset_file}.sha256" -o "${asset_file}.sha256"; \
    grep -F "${asset_sha}" "${asset_file}.sha256"; \
    printf '%s  %s\n' "${asset_sha}" "${asset_file}" | sha256sum -c -; \
    mkdir -p /vk-runtime; \
    tar -xzf "${asset_file}" -C /vk-runtime; \
    test -x /vk-runtime/vibe-kanban; \
    printf '%s@%s\n' "${VK_BRANCH}" "$(printf '%s' "${VK_COMMIT}" | cut -c1-12)" > /vk-build-version


FROM alpine:3.19 AS codex-release-downloader

ARG CODEX_RELEASE_REPO
ARG CODEX_RELEASE_TAG
ARG CODEX_RELEASE_ASSET
ARG TARGETARCH

RUN apk add --no-cache curl tar

WORKDIR /codex-release
RUN set -eux; \
    mkdir -p /codex-release-bin; \
    if [ -z "${CODEX_RELEASE_TAG}" ]; then \
      printf '#!/bin/sh\necho "Codex release asset was not configured at build time" >&2\nexit 127\n' > /codex-release-bin/codex; \
      chmod 0755 /codex-release-bin/codex; \
      exit 0; \
    fi; \
    test -n "${CODEX_RELEASE_REPO}"; \
    case "${TARGETARCH}" in \
      amd64) codex_platform="linux-x64" ;; \
      arm64) codex_platform="linux-arm64" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    asset_file="${CODEX_RELEASE_ASSET:-codex-${codex_platform}.tar.gz}"; \
    release_base_url="https://github.com/${CODEX_RELEASE_REPO}/releases/download/${CODEX_RELEASE_TAG}"; \
    curl -fsSL "${release_base_url}/${asset_file}" -o "${asset_file}"; \
    curl -fsSL "${release_base_url}/${asset_file}.sha256" -o "${asset_file}.sha256"; \
    asset_sha="$(awk 'NF {print $1; exit}' "${asset_file}.sha256")"; \
    test -n "${asset_sha}"; \
    printf '%s  %s\n' "${asset_sha}" "${asset_file}" | sha256sum -c -; \
    tar -xzf "${asset_file}" -C /codex-release-bin; \
    test -x /codex-release-bin/codex; \
    /codex-release-bin/codex --version

FROM node:22-bookworm AS dashboard-builder

WORKDIR /app

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}

RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable
RUN pnpm config set store-dir /pnpm/store

COPY package.json pnpm-lock.yaml .npmrc ./

RUN --mount=type=cache,id=vkvw-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY . .

RUN npm rebuild better-sqlite3 && npm run build && npm run build:plugin-orchestrator

FROM node:22-bookworm

ARG CODEX_RELEASE_REPO
ARG CODEX_RELEASE_TAG
ARG CODEX_RELEASE_ASSET
ARG BEADS_VERSION

# Harden APT against flaky proxy/cache behavior (helps prevent Hash Sum mismatch on macOS VM networking).
RUN set -eux; \
    rm -rf /var/lib/apt/lists/*; \
    apt-get clean; \
    printf 'Acquire::http::Pipeline-Depth 0;\nAcquire::http::No-Cache true;\nAcquire::BrokenProxy true;\nAcquire::Retries 3;\n' > /etc/apt/apt.conf.d/99network-safe

# Install development tools, supervisor, Go (for xcaddy), and GitHub CLI
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    build-essential \
    python3 \
    sqlite3 \
    zip \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    patchelf \
    supervisor \
    sudo \
    ca-certificates \
    gnupg \
    debian-keyring \
    debian-archive-keyring \
    apt-transport-https \
    ripgrep \
    inotify-tools \
    zsh \
    bubblewrap \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y gh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Go (required for building Caddy with xcaddy)
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) go_arch=amd64 ;; \
      arm64) go_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    wget "https://go.dev/dl/go1.25.7.linux-${go_arch}.tar.gz"; \
    tar -C /usr/local -xzf "go1.25.7.linux-${go_arch}.tar.gz"; \
    rm "go1.25.7.linux-${go_arch}.tar.gz"
ENV PATH="/usr/local/go/bin:${PATH}"
ENV VK_ALLOWED_ORIGINS=""

# Install Rust and Cargo
ENV CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/usr/local/cargo/bin:/usr/local/go/bin:${PATH}"
RUN cargo --version >/dev/null && rustc --version >/dev/null \
    && ln -sf /usr/local/cargo/bin/cargo /usr/local/bin/cargo \
    && ln -sf /usr/local/cargo/bin/rustc /usr/local/bin/rustc \
    && ln -sf /usr/local/cargo/bin/rustup /usr/local/bin/rustup

# Install uv for Python-based CLI tools
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_UNMANAGED_INSTALL="/usr/local/bin" sh
ENV UV_TOOL_DIR="/usr/local/share/uv/tools"
ENV UV_TOOL_BIN_DIR="/usr/local/bin"

# Install xcaddy (Caddy build tool)
ENV GOBIN="/usr/local/bin"
RUN CGO_ENABLED=0 go install github.com/caddyserver/xcaddy/cmd/xcaddy@latest

# Copy Caddy module source and shared custom Caddy build script
COPY caddy-module /tmp/caddy-module
COPY scripts/build-custom-caddy.sh /tmp/build-custom-caddy.sh

# Build custom Caddy with vibe-kanban rewrite module
RUN /tmp/build-custom-caddy.sh /tmp/caddy-module /usr/bin/caddy \
    && rm -rf /tmp/caddy-module /tmp/build-custom-caddy.sh /root/.cache/go-build /root/go/pkg

# Install Docker CLI for Docker-in-Docker support (socket mounting)
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update \
    && apt-get install -y docker-ce-cli docker-compose-plugin \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Tailscale
RUN curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg | tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null \
    && curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.tailscale-keyring.list | tee /etc/apt/sources.list.d/tailscale.list \
    && apt-get update \
    && apt-get install -y tailscale \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Google Chrome and dependencies for Chrome DevTools MCP
RUN apt-get update && apt-get install -y \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libwayland-client0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    xdg-utils \
    && ARCH="$(dpkg --print-architecture)" \
    && if [ "$ARCH" = "amd64" ]; then \
        wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome-keyring.gpg; \
        echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome-keyring.gpg] http://dl.google.com/linux/chrome/deb/ stable main" | tee /etc/apt/sources.list.d/google-chrome.list; \
        apt-get update; \
        apt-get install -y google-chrome-stable; \
      else \
        apt-get install -y chromium; \
        ln -sf /usr/bin/chromium /usr/bin/google-chrome; \
        ln -sf /usr/bin/chromium /usr/bin/google-chrome-stable; \
      fi \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install code-server using official install script
RUN curl -fsSL https://code-server.dev/install.sh | sh

# Install Hugo v0.138.0 (extended version for SCSS/SASS support)
RUN ARCH=$(dpkg --print-architecture) && \
    curl -L "https://github.com/gohugoio/hugo/releases/download/v0.138.0/hugo_extended_0.138.0_linux-${ARCH}.deb" -o /tmp/hugo.deb \
    && dpkg -i /tmp/hugo.deb \
    && rm /tmp/hugo.deb

# Create a non-root administrator user for running applications and coding
# agents. Agents stay non-root for tools that reject UID 0, but can use sudo for
# normal Linux administration. Shared mutable prefixes are group-writable/setgid
# so root and vkuser-created files remain mutually manageable without repeated
# chown -R fixes.
RUN groupadd -f vkadmin && \
    useradd -m -s /bin/bash vkuser && \
    usermod -aG vkadmin,sudo vkuser && \
    printf 'Defaults:vkuser umask=0002\nDefaults:vkuser umask_override\nvkuser ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/vkuser && \
    chmod 0440 /etc/sudoers.d/vkuser && \
    mkdir -p /home/vkuser/.local/share/vibe-kanban \
             /home/vkuser/.local/share/pnpm \
             /home/vkuser/.local/share/code-server \
             /home/vkuser/.config/code-server \
             /home/vkuser/.config/gh \
             /home/vkuser/.config/git \
             /home/vkuser/.codex \
             /home/vkuser/.npm-global/bin \
             /home/vkuser/.npm-global/lib \
             /home/vkuser/.npm \
             /home/vkuser/.cache \
             /home/vkuser/.claude \
             /home/vkuser/.openclaw \
             /home/vkuser/bosun \
             /home/vkuser/repos \
             /var/tmp/vibe-kanban/worktrees \
             /var/run/tailscale \
             /var/lib/tailscale && \
    chown -R vkuser:vkuser /home/vkuser && \
    chown -R vkuser:vkuser /var/tmp/vibe-kanban && \
    chgrp -R vkadmin /usr/local /opt /var/tmp/vibe-kanban && \
    chmod -R g+rwX /usr/local /opt /var/tmp/vibe-kanban && \
    find /usr/local /opt /var/tmp/vibe-kanban -type d -exec chmod g+s {} + && \
    printf '\numask 0002\n' >> /etc/profile && \
    printf '\numask 0002\n' >> /etc/bash.bashrc && \
    printf '\numask 0002\nexport PATH=/usr/local/lib/vk-bd-wrapper/bin:/var/lib/vd/plugin-bin:/var/lib/vd/toolchains/bin:/var/lib/vd/toolchains/npm/bin:$PATH\nexport UV_TOOL_DIR=/var/lib/vd/toolchains/uv/tools\nexport UV_TOOL_BIN_DIR=/var/lib/vd/toolchains/bin\nexport NPM_CONFIG_PREFIX=/var/lib/vd/toolchains/npm\nexport CARGO_HOME=/var/lib/vd/toolchains/cargo\nexport GOBIN=/var/lib/vd/toolchains/bin\nexport GOPATH=/var/lib/vd/toolchains/go\n' >> /home/vkuser/.bashrc && \
    chmod 755 /var/run/tailscale /var/lib/tailscale

# Configure npm to use user-local directory for global packages
RUN su - vkuser -c "npm config set prefix '/home/vkuser/.npm-global'"
ENV PATH="/home/vkuser/.npm-global/bin:${PATH}"

# Create supervisor and caddy log directories
RUN mkdir -p /var/log/supervisor /var/log/caddy

# Install tools globally as root (will be available system-wide). The multi-arch
# publish build occasionally sees transient npm registry resets, especially on
# arm64 hosted builders, so keep the step deterministic but retry boundedly.
# Skip npm @openai/codex when a configured release asset will be installed to
# /usr/local/bin/codex below. Clear CODEX_RELEASE_TAG to use official npm Codex.
RUN set -eux; \
    npm config set fetch-retries 5; \
    npm config set fetch-retry-mintimeout 20000; \
    npm config set fetch-retry-maxtimeout 120000; \
    npm_packages="@anthropic-ai/claude-code pnpm opencode-ai gitnexus"; \
    install_codex_npm=1; \
    if [ -n "${CODEX_RELEASE_TAG}" ]; then \
      install_codex_npm=0; \
    fi; \
    if [ "${install_codex_npm}" = "1" ]; then \
      npm_packages="${npm_packages} @openai/codex"; \
    fi; \
    for attempt in 1 2 3 4 5; do \
      if npm install -g ${npm_packages}; then \
        break; \
      fi; \
      if [ "$attempt" = "5" ]; then \
        exit 1; \
      fi; \
      sleep $((attempt * 10)); \
    done

COPY --from=codex-release-downloader /codex-release-bin/codex /tmp/codex-release/codex

# By default, install the configured Codex GitHub release asset. Clear
# CODEX_RELEASE_TAG to use official npm @openai/codex from the global npm
# install step above.
RUN set -eux; \
    if [ -n "${CODEX_RELEASE_TAG}" ]; then \
      test -x /tmp/codex-release/codex; \
      install -m 0755 /tmp/codex-release/codex /usr/local/bin/codex; \
      codex --version; \
      rm -rf /tmp/codex-release; \
      exit 0; \
    fi; \
    command -v codex; \
    codex --version

# Install Serena globally via uv and make the shared toolchain executable for vkuser
RUN uv tool install -p 3.13 serena-agent@latest --prerelease=allow \
    && chmod -R a+rX /usr/local/share/uv

# Install process-exporter for grouped per-process Prometheus metrics
ARG PROCESS_EXPORTER_VERSION=0.8.7
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) pe_arch=amd64 ;; \
      arm64) pe_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/process-exporter.tar.gz \
      "https://github.com/ncabatoff/process-exporter/releases/download/v${PROCESS_EXPORTER_VERSION}/process-exporter-${PROCESS_EXPORTER_VERSION}.linux-${pe_arch}.tar.gz"; \
    tar -xzf /tmp/process-exporter.tar.gz -C /tmp; \
    install -m 0755 /tmp/process-exporter-*/process-exporter /usr/local/bin/process-exporter; \
    rm -rf /tmp/process-exporter*
RUN mkdir -p /etc/process-exporter

# Install Claude Code extension
RUN su - vkuser -c "mkdir -p /home/vkuser/.local/share/code-server/extensions && code-server --install-extension anthropic.claude-code"

# Install Beads CLI. Pin to the vetted recovery-line release by default so
# container rebuilds cannot accidentally pick up untested schema migrations.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) beads_arch=amd64 ;; \
      arm64) beads_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    release_base_url="https://github.com/gastownhall/beads/releases/download/${BEADS_VERSION}"; \
    archive_name="beads_${BEADS_VERSION#v}_linux_${beads_arch}.tar.gz"; \
    curl -fsSL "${release_base_url}/${archive_name}" -o "/tmp/${archive_name}"; \
    curl -fsSL "${release_base_url}/checksums.txt" -o /tmp/beads-checksums.txt; \
    expected_sha="$(awk -v file="${archive_name}" '$2 == file { print $1 }' /tmp/beads-checksums.txt)"; \
    test -n "${expected_sha}"; \
    printf '%s  %s\n' "${expected_sha}" "/tmp/${archive_name}" | sha256sum -c -; \
    tar -xzf "/tmp/${archive_name}" -C /tmp; \
    install -m 0755 /tmp/bd /usr/local/bin/bd; \
    ln -sf bd /usr/local/bin/beads; \
    rm -f "/tmp/${archive_name}" /tmp/beads-checksums.txt /tmp/bd; \
    bd version | grep -F "${BEADS_VERSION#v}"

# Create supervisor config and plugin runtime directories. /var/lib/vd is
# intentionally writable by vkadmin so the VD app, agents, and root startup
# reconciliation can all manage persisted per-instance plugin state.
RUN mkdir -p /etc/supervisor/conf.d /etc/supervisor/conf.d/vd-generated /etc/caddy /var/lib/vd/instance-config /var/lib/vd/plugin-cache /var/lib/vd/plugins /var/lib/vd/plugin-bin /var/lib/vd/toolchains/bin /var/lib/vd/toolchains/npm /var/lib/vd/plugin-data /var/lib/vd/silverbullet/space && \
    chgrp -R vkadmin /var/lib/vd && \
    chmod -R g+rwX /var/lib/vd && \
    find /var/lib/vd -type d -exec chmod g+s {} +

COPY supervisord.vkvd.conf /etc/supervisor/conf.d/supervisord.conf
COPY ops/process-exporter.yml /etc/process-exporter/process-exporter.yml

# Copy Caddyfile and startup page
COPY Caddyfile /etc/caddy/Caddyfile
COPY Caddyfile.plugins /etc/caddy/plugins.caddy
COPY startup.html /etc/caddy/startup.html

# Copy database backup script
COPY backup-vibe-kanban-db.sh /usr/local/bin/backup-vibe-kanban-db.sh
RUN chmod +x /usr/local/bin/backup-vibe-kanban-db.sh

# Copy project files to a staging location (will be copied to volume at runtime)
COPY . /opt/vibe-kanban-vscode-web-seed
COPY --from=dashboard-builder /app/dist/plugins-orchestrator /opt/vibe-kanban-vscode-web-seed/dist/plugins-orchestrator
COPY --from=dashboard-builder /app/dist/vibe-agent /opt/vibe-kanban-vscode-web-seed/dist/vibe-agent
COPY --from=dashboard-builder /app/packages/beads-form/dist /opt/vibe-kanban-vscode-web-seed/packages/beads-form/dist
RUN chown -R vkuser:vkadmin /opt/vibe-kanban-vscode-web-seed && \
    chmod -R g+rwX /opt/vibe-kanban-vscode-web-seed && \
    find /opt/vibe-kanban-vscode-web-seed -type d -exec chmod g+s {} +
RUN printf '#!/bin/sh\nexec node /opt/vibe-kanban-vscode-web-seed/dist/vibe-agent/legacy-cli/vibe-agent.js "$@"\n' > /usr/local/bin/vibe-agent && \
    printf '#!/bin/sh\nexec node /opt/vibe-kanban-vscode-web-seed/dist/vibe-agent/cli/vk.js "$@"\n' > /usr/local/bin/vk && \
    printf '#!/bin/sh\nexec node --experimental-strip-types /opt/vibe-kanban-vscode-web-seed/scripts/beads-form/cli.ts "$@"\n' > /usr/local/bin/beads-form && \
    chmod 0755 /usr/local/bin/vibe-agent /usr/local/bin/vk /usr/local/bin/beads-form
RUN command -v vibe-agent && \
    command -v vk && \
    command -v beads-form && \
    vibe-agent --help >/dev/null && \
    vk --help >/dev/null && \
    (cd /tmp && beads-form --help >/dev/null)

# Copy packaged vibe-dashboard runtime artifacts to their final runtime path with
# final ownership set at build time. Startup must not recursively chown this tree:
# node_modules/dist are large image-layer directories and metadata mutation is slow.
RUN mkdir -p /home/vkuser/.local/share/vibe-dashboard-runtime/data && \
    chown vkuser:vkuser /home/vkuser/.local/share/vibe-dashboard-runtime /home/vkuser/.local/share/vibe-dashboard-runtime/data
COPY --chown=vkuser:vkuser --from=dashboard-builder /app/package.json /home/vkuser/.local/share/vibe-dashboard-runtime/package.json
COPY --chown=vkuser:vkuser --from=dashboard-builder /app/node_modules /home/vkuser/.local/share/vibe-dashboard-runtime/node_modules
COPY --chown=vkuser:vkuser --from=dashboard-builder /app/dist /home/vkuser/.local/share/vibe-dashboard-runtime/dist

# Copy entrypoint script that fixes docker group GID at runtime
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Copy startup scripts
COPY scripts/sync-seeded-repo.sh /usr/local/bin/sync-seeded-repo.sh
COPY plugins/scripts/vd-plugin-runtime-apply.sh /usr/local/bin/vd-plugin-runtime-apply.sh
COPY plugins/scripts/vd-plugin-reload.sh /usr/local/bin/vd-plugin-reload.sh
COPY plugins/scripts/vd-plugin-service-runner.mjs /usr/local/bin/vd-plugin-service-runner.mjs
RUN chmod +x /usr/local/bin/sync-seeded-repo.sh /usr/local/bin/vd-plugin-runtime-apply.sh /usr/local/bin/vd-plugin-reload.sh /usr/local/bin/vd-plugin-service-runner.mjs

# Install bd wrapper ahead of the real Beads CLI so VD-managed agent shells stamp
# created beads with branch/workspace/session metadata.
RUN mkdir -p /usr/local/lib/vk-bd-wrapper/bin
COPY scripts/bd-wrapper/bin/bd /usr/local/lib/vk-bd-wrapper/bin/bd
RUN chmod 0755 /usr/local/lib/vk-bd-wrapper/bin/bd \
    && ln -sf bd /usr/local/lib/vk-bd-wrapper/bin/beads
ENV PATH="/usr/local/lib/vk-bd-wrapper/bin:${PATH}"

# Copy default VS Code settings
RUN mkdir -p /home/vkuser/.local/share/code-server/User
COPY default-settings.json /home/vkuser/.local/share/code-server/User/settings.json
RUN chown -R vkuser:vkuser /home/vkuser/.local/share/code-server

# Configure git to use gh as credential helper (system-level, so users only need `gh auth login`)
RUN git config --system credential.helper '!gh auth git-credential'

COPY --from=vk-runtime-downloader /vk-runtime/vibe-kanban /usr/local/bin/vibe-kanban
COPY --from=vk-runtime-downloader /vk-build-version /usr/local/share/vibe-kanban-build-version

# Keep the hotswap write surface narrow: only the VK runtime binary,
# its version marker, and rollback state are mutable by vkuser/vkadmin.
RUN mkdir -p /var/lib/vd/hotswap/vk && \
    chown vkuser:vkadmin /usr/local/bin/vibe-kanban /usr/local/share/vibe-kanban-build-version && \
    chmod 0775 /usr/local/bin/vibe-kanban && \
    chmod 0664 /usr/local/share/vibe-kanban-build-version && \
    chown -R vkuser:vkadmin /var/lib/vd/hotswap && \
    chmod -R g+rwX /var/lib/vd/hotswap && \
    find /var/lib/vd/hotswap -type d -exec chmod g+s {} +

RUN chown -R vkuser:vkuser /home/vkuser/.local

EXPOSE 3001
EXPOSE 3007
EXPOSE 3008

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
