{
  "schemaVersion": 1,
  "name": "LV2K Child Review Workflow",
  "description": "API-loaded child workflow fixture for a blocking parent workflow_call.",
  "inputs": {
    "featureRequest": {
      "type": "markdown",
      "required": true,
      "description": "Parent task passed into the child workflow."
    }
  },
  "roles": {
    "dev": {
      "label": "Dev",
      "description": "Handles the child workflow decision."
    }
  },
  "initialState": "child_review",
  "states": {
    "child_review": {
      "owner": "dev",
      "steps": [
        {
          "id": "child_decide",
          "type": "agent_turn",
          "turnType": "decision",
          "prompt": {
            "template": "LV2K_STEP:workflow_call_child\n\nChild workflow: review {{inputs.featureRequest}} and return final decision XML."
          },
          "response": {
            "format": "xml",
            "schema": { "format": "xsd", "source": "state_actions" },
            "invalidXmlRetry": {
              "maxAttempts": 1,
              "prompt": "engine_default_with_validation_errors",
              "onExhausted": "blocked"
            },
            "storeRawXml": true,
            "rawXmlMaxChars": 20000,
            "storeParsedFields": true,
            "unknownFields": "reject_unless_allowed_by_result_contract"
          }
        }
      ],
      "actions": {
        "done": {
          "label": "Done",
          "targetState": "done",
          "result": {
            "fields": {
              "summary": { "type": "markdown" }
            },
            "required": ["summary"],
            "unknownFields": "reject"
          }
        }
      }
    },
    "done": { "terminal": true }
  }
}
